---
import { GET } from '../lib/apirequest';
import Button from './Button.astro';
const tarifs = await GET('http://localhost:1337/api/tarifs');
const tarifsTries = tarifs.sort((a, b) => {
  const prixA = parseInt(a.price.replace(/\D/g, ''));
  const prixB = parseInt(b.price.replace(/\D/g, ''));
  return prixA - prixB;
});
---

<section class="py-16 px-8 bg-[#f5f5f5]">
  <div class="max-w-[1200px] mx-auto text-center">
    <h2 class="text-4xl text-[#11111170] mb-12">Offres de tarification</h2>

    <div class="flex justify-center gap-8 flex-wrap">
      {tarifsTries.map((tarif) => (
        <div class="bg-white rounded-lg p-10 shadow-[0_4px_20px_rgba(0,0,0,0.08)] w-[calc(33.333%-1.5rem)] text-center">
          <h3 class="text-2xl text-[#FFB400] mb-4">{tarif.name}</h3>
          <p class="text-3xl font-bold text-[#1a1a2e] mb-[0.3rem]">{tarif.price}</p>
          <p class="text-xl font-semibold text-[#555] mb-8">{tarif.price_ht}</p>

          <ul class="list-none p-0 mb-8 text-left">
            {(tarif.features ?? '').split('\n').map((avantage) => (
              <li class="py-2 pl-6 relative text-[#444] border-b border-[#eee] before:content-['✱'] before:absolute before:left-0 before:text-[#FFB400] before:font-bold">
                {avantage}
              </li>
            ))}
          </ul>

          <Button texte="Acheter maintenant" href="/essai" style="jaune" />
        </div>
      ))}
    </div>
  </div>
</section>