---
import { GET } from '../lib/apirequest';
const articles = await GET('http://localhost:1337/api/articles?populate=*');
---
<main class="blog">
  <div class="blog-container">
    {articles.map((article) => (
      <div class="article-card">
        <img
          src={article.cover ? `http://localhost:1337${article.cover.url}` : '/placeholder.jpg'}
          alt={article.title}
          class="article-cover"
        />
        <h2>
          <a href={`/blog/${article.slug}`}>{article.title}</a>
        </h2>
        <p>{article.description}</p>
      </div>
    ))}
  </div>
</main>
<style>
  .blog {
    background: #ffffff;
    padding: 3rem 2rem;
  }

  .blog-container {
    max-width: 1100px;
    margin: 0; 
    margin-left: 10rem; 
}

  .article-card {
    display: block;
    text-decoration: none;
    color: inherit;
    margin-bottom: 1rem;
  }

  .article-cover {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: -1rem;
  }

  .article-card h2 :hover {
    text-decoration: underline;
  }
  .article-card h2 a {
    color: #111;                 
    text-decoration: none;        
  }

  .article-card h2 a:hover {
    text-decoration: underline;   
  }

  .article-card h2 {
    font-size: 2rem;
    color: #111;
    margin-bottom: 0.1rem;
    font-weight: 500;
  }

  .article-card p {
    color: #111;
    line-height: 1.7;
    font-size: 1.2rem;
  }
</style>