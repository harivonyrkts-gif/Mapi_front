---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import Button from '../components/Button.astro';
---
<section class="hero">
  <img src="/tarif.jpg" alt="Tarifs" class="hero-bg">
  <div class="hero-texte">
    <h1>Tarification simple et transparente qui évolue avec vos besoins</h1>
    <p>Connectez-vous et engagez vos clients avec les services SMS de Mapi.</p>
    <Button texte="Commencez gratuitement" href="/essai" style="jaune" />
  </div>
</section>

 <style>

    .hero {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 500px;
      overflow: hidden;
    }
    .hero::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 1;
    }

    .hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }

    .hero-texte {
      position: relative;
      z-index: 2;
      max-width: 45%;
      padding: 2rem 15rem;
      margin-top: 0rem;
      color: white;
    }

    h1 {
      font-family: 'Inter', sans-serif;
      font-size: 4rem;
      font-weight: 400;
      margin-bottom: 1rem;
      color: rgb(255, 255, 255); 
    }

    p {
      font-size: 1.5rem;
      color: #ffffff;
      margin-bottom: 3rem;
    }
 </style>